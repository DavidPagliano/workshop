NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=
# Obligatorio, mínimo 32 caracteres.
JWT_SECRET=
# Proxies de confianza delante de la API (para el rate limiting por IP).
# 1 si está detrás de un único reverse proxy (Render, Railway, Nginx); 0 en local.
# Si se omite: 1 en producción y 0 en desarrollo.
# TRUST_PROXY=1

# ── CORS / orígenes del frontend ───────────────────────────────────────────
# El origen debe coincidir EXACTAMENTE (esquema + host, sin barra final).
# Si el frontend de producción no está aquí, sus peticiones reciben 403.
# En producción (Render) usar NODE_ENV=production.
# FRONTEND_URL: origen de desarrollo.
# FRONTEND_PREVIEW_URL: preview local de Vite.
# FRONTEND_PRODUCTION_URL / FRONTEND_PRODUCTION_URL_2: dominios productivos
#   (ej. URL de Netlify y su dominio personalizado).
# GITHUB_URL: dominio de GitHub Pages, si se usa.
# FRONTEND_PREVIEW_URL=https://localhost:4173
# FRONTEND_PRODUCTION_URL=https://tu-sitio.netlify.app
# FRONTEND_PRODUCTION_URL_2=https://workshop2026.complejoiema.com.ar
# GITHUB_URL=https://tu-usuario.github.io

# ── Rate limiting (opcionales) ─────────────────────────────────────────────
# El día del evento varios usuarios pueden compartir la misma IP (WiFi/NAT).
# Los límites por token/usuario no se comparten; los de IP son holgados.
# Global (todas las rutas): 10000 peticiones / 15 min.
# RL_GLOBAL_WINDOW_MS=900000
# RL_GLOBAL_LIMIT=10000
# Login: por IP + usuario, 30 intentos / 15 min.
# RL_LOGIN_WINDOW_MS=900000
# RL_LOGIN_LIMIT=30
# Registro de usuarios: 60 / hora.
# RL_REGISTER_WINDOW_MS=3600000
# RL_REGISTER_LIMIT=60
# Auditoría (por usuario): 600 / min.
# RL_AUDIT_WINDOW_MS=60000
# RL_AUDIT_LIMIT=600
